// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoadStatus {
  QUOTED
  BOOKED
  CANCELED
  IN_TRANSIT
  DELIVERED
}

model Shipper {
  id            String   @id @default(uuid())
  contactPerson String
  company       String
  loads         Load[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Carrier {
  id        String   @id @default(uuid())
  mcNumber  String   @unique
  name      String
  loads     Load[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Load {
  id                    String     @id @default(uuid())
  origin                String
  destination           String
  status                LoadStatus @default(QUOTED)
  estimatedPickupDate   DateTime?
  estimatedDeliveryDate DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  shipper               Shipper    @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  shipperId             String
  carrier               Carrier?   @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  carrierId             String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}
